'use client'

import { useState, useEffect } from 'react'
import { Calendar, dateFnsLocalizer, Views } from 'react-big-calendar'
import { format, parse, startOfWeek, getDay } from 'date-fns'
import { cs } from 'date-fns/locale'
import 'react-big-calendar/lib/css/react-big-calendar.css'
import { useSession } from 'next-auth/react'
import { useRouter } from 'next/navigation'
import { Event, CalendarEvent } from '@/types/calendar'
import { OutlookCalendarService } from '@/lib/outlook-calendar'
import { ErpCalendarService } from '@/lib/erp-calendar'

// Setup localizer
const locales = {
  'cs': cs,
}

const localizer = dateFnsLocalizer({
  format,
  parse,
  startOfWeek,
  getDay,
  locales,
})

// Event styling
const eventStyleGetter = (event: CalendarEvent) => {
  const isOutlookEvent = event.id.startsWith('outlook-')
  const isErpEvent = event.resource.isErpEvent
  const baseColor = {
    PROJECT: '#3b82f6', // blue-500
    MEETING: '#f97316', // orange-500
    HOLIDAY: '#10b981', // emerald-500
    OTHER: '#6b7280', // gray-500
    ERP_UPGRADE: '#8b5cf6', // purple-500
    ERP_PATCH: '#f59e0b', // amber-500
  }[event.resource.type] || '#6b7280'
  
  let backgroundColor = baseColor
  let border = '0px'
  let fontSize = '14px'
  
  if (isOutlookEvent) {
    backgroundColor = '#0078d4' // Microsoft blue for Outlook events
    border = '2px solid #0078d4'
    fontSize = '12px'
  } else if (isErpEvent) {
    border = '2px solid #8b5cf6' // Purple border for ERP events
    fontSize = '12px'
  }
  
  return {
    style: {
      backgroundColor,
      borderRadius: '4px',
      opacity: 0.8,
      color: 'white',
      border,
      display: 'block',
      fontSize
    }
  }
}

export default function CalendarPage() {
  const { data: session, status } = useSession()
  const router = useRouter()
  const [events, setEvents] = useState<CalendarEvent[]>([])
  const [loading, setLoading] = useState(true)
  const [showModal, setShowModal] = useState(false)
  const [selectedEvent, setSelectedEvent] = useState<CalendarEvent | null>(null)
  const [selectedSlot, setSelectedSlot] = useState<{ start: Date; end: Date } | null>(null)
  const [currentView, setCurrentView] = useState(Views.MONTH)
  const [currentDate, setCurrentDate] = useState(new Date())
  const [outlookEnabled, setOutlookEnabled] = useState(false)
  const [syncingWithOutlook, setSyncingWithOutlook] = useState(false)
  const [syncError, setSyncError] = useState<string | null>(null)
  const [outlookEventCount, setOutlookEventCount] = useState(0)
  
  // ERP states
  const [erpEnabled, setErpEnabled] = useState(false)
  const [syncingWithErp, setSyncingWithErp] = useState(false)
  const [erpSyncError, setErpSyncError] = useState<string | null>(null)
  const [erpEventCount, setErpEventCount] = useState(0)
  const [userRole, setUserRole] = useState<string>('USER')

  useEffect(() => {
    if (status === 'unauthenticated') {
      router.push('/login')
    }
  }, [status, router])

  useEffect(() => {
    if (session) {
      fetchEvents()
      // Check if Outlook integration is enabled
      setOutlookEnabled(OutlookCalendarService.hasOutlookIntegration())
    }
  }, [session])

  // Synchronizovat více událostí
  const syncMoreOutlookEvents = async () => {
    if (!outlookEnabled) {
      return
    }
    
    setSyncingWithOutlook(true)
    setSyncError(null)
    
    try {
      // Get current date range for sync - celý aktuální rok
      const now = new Date()
      const start = new Date(now.getFullYear(), 0, 1) // 1. leden aktuálního roku
      start.setHours(0, 0, 0, 0)
      const end = new Date(now.getFullYear() + 1, 0, 1) // 1. leden příštího roku
      end.setHours(0, 0, 0, 0)
      
      // Fetch more Outlook events
      const outlookEvents = await OutlookCalendarService.fetchMoreOutlookEvents(
        start.toISOString(),
        end.toISOString()
      )
      
      setOutlookEventCount(outlookEvents.length)
      
      // Convert Outlook events to CalendarEvent format (jednodušší)
      const calendarEvents: CalendarEvent[] = outlookEvents.map((outlookEvent) => {
        const startDate = new Date(outlookEvent.start.dateTime)
        const endDate = new Date(outlookEvent.end.dateTime)
        
        return {
          id: outlookEvent.id,
          title: outlookEvent.subject || 'Bez názvu',
          start: startDate,
          end: endDate,
          allDay: outlookEvent.isAllDay || false,
          resource: {
            id: outlookEvent.id,
            title: outlookEvent.subject || 'Bez názvu',
            description: outlookEvent.bodyPreview || '',
            startDate: outlookEvent.start.dateTime,
            endDate: outlookEvent.end.dateTime,
            type: 'OTHER' as Event['type'],
            allDay: outlookEvent.isAllDay || false,
            location: outlookEvent.location?.displayName || '',
            isOutlookEvent: true
          }
        }
      })
      
      setEvents(calendarEvents)
      
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error occurred'
      setSyncError(errorMessage)
      console.error('Error syncing more Outlook events:', error)
    } finally {
      setSyncingWithOutlook(false)
    }
  }

  // Synchronizovat ERP události
  const syncErpEvents = async () => {
    setSyncingWithErp(true)
    setErpSyncError(null)
    
    try {
      const response = await fetch('/api/erp-calendar/sync', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      })
      
      if (!response.ok) {
        const errorData = await response.json()
        throw new Error(errorData.error || 'Synchronization failed')
      }
      
      const result = await response.json()
      console.log('ERP Sync result:', result)
      
      // Refresh events after sync
      await fetchEvents()
      
      // Update ERP event count
      const erpResponse = await fetch('/api/erp-calendar')
      if (erpResponse.ok) {
        const erpEvents = await erpResponse.json()
        setErpEventCount(erpEvents.length)
      }
      
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error occurred'
      setErpSyncError(errorMessage)
      console.error('Error syncing ERP events:', error)
    } finally {
      setSyncingWithErp(false)
    }
  }

  // Zobrazit informace o uživateli
  const showUserInfo = async () => {
    try {
      const userInfo = await OutlookCalendarService.getUserInfo()
      alert(`Informace o uživateli:\nJméno: ${userInfo.displayName || 'N/A'}\nEmail: ${userInfo.mail || userInfo.userPrincipalName || 'N/A'}\nID: ${userInfo.id || 'N/A'}`)
    } catch (error) {
      console.error('Chyba při získávání informací o uživateli:', error)
      alert('Chyba při získávání informací o uživateli')
    }
  }

  // Zobrazit kalendáře
  const showCalendars = async () => {
    try {
      const calendars = await OutlookCalendarService.getCalendars()
      alert(`Nalezeno ${calendars.length} kalendářů:\n${calendars.map((cal: any) => `- ${cal.name} (${cal.id})`).join('\n')}`)
    } catch (error) {
      console.error('Chyba při získávání kalendářů:', error)
      alert('Chyba při získávání kalendářů')
    }
  }

  const syncWithOutlook = async () => {
    if (!outlookEnabled) {
      return
    }
    
    setSyncingWithOutlook(true)
    setSyncError(null)
    
    try {
      // Get current date range for sync - celý aktuální rok
      const now = new Date()
      const start = new Date(now.getFullYear(), 0, 1) // 1. leden aktuálního roku
      start.setHours(0, 0, 0, 0)
      const end = new Date(now.getFullYear() + 1, 0, 1) // 1. leden příštího roku
      end.setHours(0, 0, 0, 0)
      
      // Fetch Outlook events
      const outlookEvents = await OutlookCalendarService.fetchOutlookEvents(
        start.toISOString(),
        end.toISOString()
      )
      
      setOutlookEventCount(outlookEvents.length)
      
      // Convert Outlook events to local format and merge with existing events
      // Convert Outlook events to CalendarEvent format (jednodušší)
      const calendarEvents: CalendarEvent[] = outlookEvents.map((outlookEvent) => {
        const startDate = new Date(outlookEvent.start.dateTime)
        const endDate = new Date(outlookEvent.end.dateTime)
        
        return {
          id: outlookEvent.id,
          title: outlookEvent.subject || 'Bez názvu',
          start: startDate,
          end: endDate,
          allDay: outlookEvent.isAllDay || false,
          resource: {
            id: outlookEvent.id,
            title: outlookEvent.subject || 'Bez názvu',
            description: outlookEvent.bodyPreview || '',
            startDate: outlookEvent.start.dateTime,
            endDate: outlookEvent.end.dateTime,
            type: 'OTHER' as Event['type'],
            allDay: outlookEvent.isAllDay || false,
            location: outlookEvent.location?.displayName || '',
            isOutlookEvent: true
          }
        }
      })
      
      setEvents(calendarEvents)
      
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error occurred'
      setSyncError(errorMessage)
      console.error('Error syncing with Outlook:', error)
    } finally {
      setSyncingWithOutlook(false)
    }
  }

  const mergeOutlookEvents = async (outlookEvents: any[]) => {
    try {
      
      // Get current local events - pokud selže, použijeme jen Outlook události
      let localEvents: Event[] = []
      try {
        const response = await fetch('/api/events')
        if (response.ok) {
          localEvents = await response.json()
        }
      } catch (error) {
        // Failed to fetch local events, using only Outlook events
      }
      
      // Converting Outlook events
      const convertedOutlookEvents = outlookEvents.map((outlookEvent) => ({
        id: outlookEvent.id,
        title: outlookEvent.subject || 'Bez názvu',
        start: new Date(outlookEvent.start.dateTime || outlookEvent.start.date),
        end: new Date(outlookEvent.end.dateTime || outlookEvent.end.date),
        resource: {
          isOutlookEvent: true,
          outlookEvent
        },
        allDay: outlookEvent.isAllDay || false
      }))
      
      // Combine local and Outlook events
      const allEvents = [...localEvents, ...convertedOutlookEvents]
      
      return allEvents
    } catch (error) {
      return []
    }
  }

  const toggleOutlookIntegration = () => {
    const newState = !outlookEnabled
    setOutlookEnabled(newState)
    OutlookCalendarService.setOutlookIntegration(newState)
  }

  useEffect(() => {
    if (outlookEnabled && !syncingWithOutlook) {
      syncWithOutlook()
    }
  }, [outlookEnabled])

  const fetchEvents = async () => {
    try {
      const response = await fetch('/api/events')
      if (response.ok) {
        const data: Event[] = await response.json()
        const calendarEvents: CalendarEvent[] = data.map(event => ({
          id: event.id,
          title: event.title,
          start: new Date(event.startDate),
          end: new Date(event.endDate),
          allDay: event.allDay,
          resource: event,
        }))
        setEvents(calendarEvents)

        // Update ERP event count
        const erpEvents = data.filter(event => event.isErpEvent)
        setErpEventCount(erpEvents.length)
      }
    } catch (error) {
      console.error('Error fetching events:', error)
    } finally {
      setLoading(false)
    }
  }

  const handleSelectEvent = (event: CalendarEvent) => {
    setSelectedEvent(event)
    setShowModal(true)
  }

  const handleSelectSlot = ({ start, end }: { start: Date; end: Date }) => {
    setSelectedSlot({ start, end })
    setSelectedEvent(null)
    setShowModal(true)
  }

  // Custom navigation with year support
  const handleNavigate = (date: Date, view: string) => {
    setCurrentDate(date)
    setCurrentView(view as Views)
  }

  // Navigate by month
  const navigateByMonth = (direction: number) => {
    const newDate = new Date(currentDate)
    newDate.setMonth(newDate.getMonth() + direction)
    setCurrentDate(newDate)
  }

  // Navigate by year
  const navigateByYear = (direction: number) => {
    const newDate = new Date(currentDate)
    newDate.setFullYear(newDate.getFullYear() + direction)
    setCurrentDate(newDate)
  }

  const handleCreateEvent = async (eventData: Partial<Event>) => {
    try {
      const response = await fetch('/api/events', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          ...eventData,
          startDate: eventData.startDate || selectedSlot?.start,
          endDate: eventData.endDate || selectedSlot?.end,
        }),
      })

      if (response.ok) {
        // Jen lokální uložení, bez synchronizace do Outlooku
        await fetchEvents()
        setShowModal(false)
        setSelectedSlot(null)
      }
    } catch (error) {
      console.error('Error creating event:', error)
    }
  }

  const handleUpdateEvent = async (eventData: Partial<Event>) => {
    if (!selectedEvent) return

    // Zabrání editace Outlook událostí
    if (selectedEvent.resource?.isOutlookEvent) {
      alert('Outlook události nelze editovat z portálu. Prosím, upravte je přímo v Outlooku.')
      return
    }

    // Zabrání editace ERP událostí bez oprávnění
    if (selectedEvent.resource?.isErpEvent) {
      if (userRole !== 'ADMIN' && userRole !== 'IT' && userRole !== 'MANAGER') {
        alert('ERP události mohou editovat pouze uživatelé s oprávněním (ADMIN, IT, MANAGER).')
        return
      }
    }

    try {
      const response = await fetch(`/api/events/${selectedEvent.id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(eventData),
      })

      if (response.ok) {
        // Jen lokální uložení, bez synchronizace do Outlooku
        await fetchEvents()
        setShowModal(false)
        setSelectedEvent(null)
      }
    } catch (error) {
      console.error('Error updating event:', error)
    }
  }

  const handleDeleteEvent = async () => {
    if (!selectedEvent) return
    
    // Zabrání mazání Outlook událostí
    if (selectedEvent.resource?.isOutlookEvent) {
      alert('Outlook události nelze mazat z portálu. Prosím, smažte je přímo v Outlooku.')
      return
    }

    // Zabrání mazání ERP událostí bez oprávnění
    if (selectedEvent.resource?.isErpEvent) {
      if (userRole !== 'ADMIN' && userRole !== 'IT') {
        alert('ERP události mohou mazat pouze uživatelé s oprávněním (ADMIN, IT).')
        return
      }
    }

    try {
      const response = await fetch(`/api/events/${selectedEvent.id}`, {
        method: 'DELETE',
      })

      if (response.ok) {
        await fetchEvents()
        setShowModal(false)
        setSelectedEvent(null)
      }
    } catch (error) {
      console.error('Error deleting event:', error)
    }
  }

  if (status === 'loading' || loading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-lg">Načítání...</div>
      </div>
    )
  }

  return (
    <div className="w-full p-6">
      <div className="mb-6">
        <h1 className="text-3xl font-bold tracking-tight text-gray-900 mb-2">
          Kalendář
        </h1>
        <p className="text-lg text-gray-600 mb-4">
          Plánování událostí a schůzek
        </p>
        
        {/* Outlook Integration Panel */}
        <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <div className="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                <svg className="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </div>
              <div>
                <h3 className="font-medium text-blue-900">Outlook kalendář</h3>
                <p className="text-sm text-blue-700">
                  {outlookEnabled ? 'Povoleno' : 'Zakázáno'} - zobrazování událostí z Microsoft Outlook (pouze čtení)
                  {outlookEnabled && outlookEventCount > 0 && (
                    <span className="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded-full">
                      {outlookEventCount} Outlook událostí
                    </span>
                  )}
                </p>
                {syncError && (
                  <p className="text-sm text-red-600 mt-1">
                    Chyba: {syncError}
                  </p>
                )}
              </div>
            </div>
            <div className="flex items-center space-x-2">
              <button
                onClick={toggleOutlookIntegration}
                className={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                  outlookEnabled
                    ? 'bg-blue-600 text-white hover:bg-blue-700'
                    : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                }`}
              >
                {outlookEnabled ? 'Zakázat' : 'Povolit'}
              </button>
              {outlookEnabled && (
                <>
                <button
                  onClick={syncMoreOutlookEvents}
                  disabled={syncingWithOutlook}
                  className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed text-sm font-medium"
                >
                  {syncingWithOutlook ? 'Synchronizuje se...' : 'Synchronizovat'}
                </button>
                <button
                    onClick={showCalendars}
                    className="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 transition-colors"
                  >
                    Zobrazit kalendáře
                  </button>
                <button
                    onClick={showUserInfo}
                    className="px-4 py-2 bg-purple-600 text-white rounded-md text-sm font-medium hover:bg-purple-700 transition-colors"
                  >
                    Informace o uživateli
                  </button>
                </>
              )}
            </div>
          </div>
        </div>

        {/* ERP Integration Panel */}
        <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <div className="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center">
                <svg className="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 2a1 1 0 000 2v2a1 1 0 000 2H5a1 1 0 000-2V2a1 1 0 00-1-1H9zm0 4a1 1 0 000 2v2a1 1 0 000 2H5a1 1 0 000-2V6a1 1 0 00-1-1H9zm0 4a1 1 0 000 2v2a1 1 0 000 2H5a1 1 0 000-2v-2a1 1 0 00-1-1H9zm0 4a1 1 0 000 2v2a1 1 0 000 2H5a1 1 0 000-2v-2a1 1 0 00-1-1H9z"/>
                </svg>
              </div>
              <div>
                <h3 className="font-medium text-purple-900">ERP kalendář</h3>
                <p className="text-sm text-purple-700">
                  Sdílené události z ERP systému (upgrady a patchování)
                  {erpEventCount > 0 && (
                    <span className="ml-2 text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded-full">
                      {erpEventCount} ERP událostí
                    </span>
                  )}
                </p>
                {erpSyncError && (
                  <p className="text-sm text-red-600 mt-1">
                    Chyba: {erpSyncError}
                  </p>
                )}
              </div>
            </div>
            <div className="flex items-center space-x-2">
              <button
                onClick={syncErpEvents}
                disabled={syncingWithErp}
                className="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 disabled:bg-purple-400 disabled:cursor-not-allowed text-sm font-medium"
              >
                {syncingWithErp ? 'Synchronizuje se...' : 'Synchronizovat ERP'}
              </button>
            </div>
          </div>
        </div>

      <div className="bg-white rounded-lg shadow-lg p-4" style={{ minHeight: '600px' }}>
        {/* Navigation Controls */}
        <div className="flex flex-col sm:flex-row justify-between items-center mb-4 space-y-2 sm:space-y-0 sm:space-x-4">
          {/* Year Navigation */}
          <div className="flex items-center space-x-2">
            <button
              onClick={() => navigateByYear(-1)}
              className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors text-sm font-medium"
            >
              ← Rok
            </button>
            <span className="text-lg font-semibold text-gray-800 min-w-[80px] text-center">
              {currentDate.getFullYear()}
            </span>
            <button
              onClick={() => navigateByYear(1)}
              className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors text-sm font-medium"
            >
              Rok →
            </button>
          </div>

          {/* Month Navigation */}
          <div className="flex items-center space-x-2">
            <button
              onClick={() => navigateByMonth(-1)}
              className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors text-sm font-medium"
            >
              ← Měsíc
            </button>
            <span className="text-lg font-semibold text-gray-800 min-w-[100px] text-center">
              {currentDate.toLocaleDateString('cs-CZ', { month: 'long' })}
            </span>
            <button
              onClick={() => navigateByMonth(1)}
              className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors text-sm font-medium"
            >
              Měsíc →
            </button>
          </div>
        </div>

        <Calendar
          localizer={localizer}
          events={events}
          startAccessor="start"
          endAccessor="end"
          style={{ height: 500 }}
          views={[Views.MONTH, Views.WEEK, Views.AGENDA]}
          view={currentView}
          date={currentDate}
          onNavigate={handleNavigate}
          onView={setCurrentView}
          onSelectEvent={handleSelectEvent}
          onSelectSlot={handleSelectSlot}
          selectable
          eventPropGetter={eventStyleGetter}
          messages={{
            next: "Další",
            previous: "Předchozí",
            today: "Dnes",
            month: "Měsíc",
            week: "Týden",
            day: "Den",
            agenda: "Agenda",
            date: "Datum",
            time: "Čas",
            event: "Událost",
            noEventsInRange: "Žádné události v tomto období.",
          }}
        />
      </div>

      {/* Modal for creating/editing events */}
      {showModal && (
        <EventModal
          event={selectedEvent}
          slot={selectedSlot}
          onClose={() => {
            setShowModal(false)
            setSelectedEvent(null)
            setSelectedSlot(null)
          }}
          onSave={selectedEvent?.resource?.isOutlookEvent ? () => {} : (selectedEvent ? handleUpdateEvent : handleCreateEvent)}
          onDelete={selectedEvent?.resource?.isOutlookEvent ? undefined : (selectedEvent ? handleDeleteEvent : undefined)}
        />
      )}
    </div>
  )
}

// Event Modal Component
function EventModal({
  event,
  slot,
  onClose,
  onSave,
  onDelete
}: {
  event?: CalendarEvent | null
  slot?: { start: Date; end: Date } | null
  onClose: () => void
  onSave: (data: Partial<Event>) => void
  onDelete?: () => void
}) {
  const [formData, setFormData] = useState({
    title: event?.title || '',
    description: event?.resource?.description || '',
    type: event?.resource?.type || 'OTHER' as Event['type'],
    allDay: event?.allDay || false,
    location: event?.resource?.location || '',
    startDate: event?.resource?.startDate || slot?.start?.toISOString().slice(0, 16) || '',
    endDate: event?.resource?.endDate || slot?.end?.toISOString().slice(0, 16) || '',
  })

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    onSave(formData)
  }

  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div className="bg-white rounded-lg p-6 w-full max-w-md">
        <h2 className="text-xl font-bold mb-4">
          {event ? (
            event.resource?.isOutlookEvent ? 'Detail události (Outlook)' :
            event.resource?.isErpEvent ? 'Detail ERP události' :
            'Upravit událost'
          ) : 'Vytvořit událost'}
        </h2>

        {event && event.resource?.isOutlookEvent ? (
          // Outlook událost - pouze pro čtení
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Název</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                {event.title}
              </div>
            </div>
            
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Popis</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700 min-h-[60px]">
                {event?.resource?.description || 'Žádný popis'}
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Místo konání</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                {event?.resource?.location || 'Neuvedeno'}
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Typ</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                Outlook událost
              </div>
            </div>

            <div className="flex justify-end pt-4">
              <button
                type="button"
                onClick={onClose}
                className="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400"
              >
                Zavřít
              </button>
            </div>
          </div>
        ) : event?.resource?.isErpEvent ? (
          // ERP událost - pouze pro čtení s možností editace/mazání
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Název</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                {event.title}
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Typ</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                {event.resource.type === 'ERP_UPGRADE' ? 'Upgrade' : 'Patchování'}
              </div>
            </div>

            {event.resource.erpProject && (
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Projekt</label>
                <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                  {event.resource.erpProject}
                </div>
              </div>
            )}

            {event.resource.erpJiraKey && (
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Jira klíč</label>
                <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                  {event.resource.erpJiraKey}
                </div>
              </div>
            )}

            {event.resource.erpResolver && (
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Řešitel</label>
                <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                  {event.resource.erpResolver}
                </div>
              </div>
            )}

            {event.resource.erpSystems && (
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Systémy</label>
                <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                  {event.resource.erpSystems}
                </div>
              </div>
            )}

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Popis</label>
              <div className="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                {event.resource.description}
              </div>
            </div>

            <div className="flex justify-end pt-4">
              <button
                type="button"
                onClick={onClose}
                className="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400"
              >
                Zavřít
              </button>
            </div>
          </div>
        ) : (
          // Lokální událost - editovatelný formulář
          <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Název
            </label>
            <input
              type="text"
              required
              value={formData.title}
              onChange={(e) => setFormData({ ...formData, title: e.target.value })}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Typ
            </label>
            <select
              value={formData.type}
              onChange={(e) => setFormData({ ...formData, type: e.target.value as Event['type'] })}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
            >
              <option value="PROJECT">Projekt</option>
              <option value="MEETING">Schůzka</option>
              <option value="HOLIDAY">Dovolená</option>
              <option value="OTHER">Ostatní</option>
            </select>
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Popis
            </label>
            <textarea
              value={formData.description}
              onChange={(e) => setFormData({ ...formData, description: e.target.value })}
              rows={3}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Místo konání
            </label>
            <input
              type="text"
              value={formData.location}
              onChange={(e) => setFormData({ ...formData, location: e.target.value })}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
              placeholder="Např. Zasedací místnost 1"
            />
          </div>

          <div className="flex items-center">
            <input
              type="checkbox"
              id="allDay"
              checked={formData.allDay}
              onChange={(e) => setFormData({ ...formData, allDay: e.target.checked })}
              className="mr-2"
            />
            <label htmlFor="allDay" className="text-sm font-medium text-gray-700">
              Celodenní událost
            </label>
          </div>

          {!formData.allDay && (
            <>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Začátek
                </label>
                <input
                  type="datetime-local"
                  required
                  value={formData.startDate}
                  onChange={(e) => setFormData({ ...formData, startDate: e.target.value })}
                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Konec
                </label>
                <input
                  type="datetime-local"
                  required
                  value={formData.endDate}
                  onChange={(e) => setFormData({ ...formData, endDate: e.target.value })}
                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"
                />
              </div>
            </>
          )}

          <div className="flex justify-between pt-4">
            <div>
              {onDelete && (
                <button
                  type="button"
                  onClick={onDelete}
                  className="px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600"
                >
                  Smazat
                </button>
              )}
            </div>
            <div className="space-x-2">
              <button
                type="button"
                onClick={onClose}
                className="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400"
              >
                Zrušit
              </button>
              <button
                type="submit"
                className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600"
              >
                Uložit
              </button>
            </div>
          </div>
        </form>
        )}
      </div>
    </div>
  )
}
